# Copy to .env and fill in. Never commit .env.

# --- Anthropic -------------------------------------------------------------
# SERVER ONLY. Read exclusively from the /api/explain route handler.
# Never prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# --- Database --------------------------------------------------------------
# Host port for the local container (`pnpm db:up`). Change it if something else
# already listens on 5432 — and change the port in DATABASE_URL to match.
POSTGRES_PORT=5432

# Matches docker-compose.yml for local dev.
# Production: swap for a Neon or Vercel Postgres connection string.
DATABASE_URL=postgresql://sudoku:sudoku@localhost:5432/sudoku_trainer

# --- Cost controls ---------------------------------------------------------
# Explanations allowed per anonymous session per day.
EXPLAIN_DAILY_LIMIT=10
